<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>
    const ROOM_ID = "<%= roomId %>";
    const INITIAL_VIDEO = <%= videoOn %>;
    const INITIAL_AUDIO = <%= audioOn %>;
  </script>
  <script defer src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <script defer src="/socket.io/socket.io.js"></script>
  <script defer src="script.js"></script>

  <!-- CodeMirror things -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/codemirror.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/codemirror.min.js"></script>
  <!-- Themes -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/theme/ayu-dark.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/theme/eclipse.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/theme/material.css">
  <!-- Languages -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/python/python.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/javascript/javascript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/clike/clike.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/addon/edit/closebrackets.js"></script>

  <title>Room</title>
  <style>
    body {
      display: flex;
      background-color: #19171726;
      height: 90vh;
      margin: 0;
    }

    #video-grid {
      display: flex;
      flex-direction: column;
      margin-top: 25px;
      gap: 15px;
      padding: 15px;
      width: 300px;
      height: 90vh;
      overflow-y: auto;
    }

    #video-grid::-webkit-scrollbar {
      width: 8px;
    }
    #video-grid::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 4px;
    }

    .video-container {
      position: relative;
      width: 100%;
      aspect-ratio: 4/3;
      height: auto;
      border-radius: 15px;
      overflow: hidden;
      flex-shrink: 0;
      background-color: #000;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    }

    /* Highlight your own video with a coloured border */
    .video-container.self {
      box-shadow: 0 0 0 3px #6366f1, 0 4px 6px rgba(0, 0, 0, 0.4);
    }

    /* Overlay shown when a remote peer turns their cam off */
    .cam-off-overlay {
      position: absolute;
      inset: 0;
      background: #111;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #888;
      font-size: 13px;
      font-family: sans-serif;
      border-radius: 15px;
      pointer-events: none;
      z-index: 5;
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 15px;
      transform: rotateY(180deg);
      background-color: #000;
    }

    .video-controls {
      position: absolute;
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      background-color: rgba(0, 0, 0, 0.5);
      padding: 5px 10px;
      border-radius: 20px;
      opacity: 0;
      transition: opacity 0.3s;
    }

    .video-container:hover .video-controls {
      opacity: 1;
    }

    .control-button {
      background: none;
      border: none;
      color: white;
      cursor: pointer;
      padding: 5px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
    }

    .control-button:hover {
      background-color: rgba(255, 255, 255, 0.1);
    }

    .control-button.muted {
      background-color: #ef4444;
      color: white;
    }

    .control-button svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .editor {
      width: 1200px;
      max-width: 1200px;
      min-height: 80vh;
      border: 1px solid #ddd;
      margin: auto;
      font-size: x-large;
      position: relative;
    }

    .CodeMirror {
      margin-top: 50px;
      height: 88vh;
    }

    .controls {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 10;
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .controls select {
      padding: 5px;
      border-radius: 4px;
      border: 1px solid #ddd;
      background-color: white;
      cursor: pointer;
    }

    .controls select:hover {
      border-color: #aaa;
    }

    #copy-room-btn {
      padding: 5px 10px;
      border-radius: 6px;
      border: 1px solid #6366f1;
      background: rgba(99, 102, 241, 0.15);
      color: #a5b4fc;
      font-size: 12px;
      font-family: monospace;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    #copy-room-btn:hover {
      background: rgba(99, 102, 241, 0.35);
      color: #fff;
    }

    #copy-room-btn.copied {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.15);
      color: #86efac;
    }

    body.theme-light {
      background-color: #ffffff;
    }

    body.theme-gray {
      background-color: #2f3129;
    }

    body.theme-dark {
      background-color: #1a1a1a;
    }
  </style>
</head>
<body>
  <div id="video-grid"></div>
  
  <div class="controls">
    <button id="copy-room-btn" title="Copy room ID to clipboard">⧉ Copy Room ID</button>

    <select id="language-selector">
      <option value="python">Python</option>
      <option value="javascript">JavaScript</option>
      <option value="text/x-java">Java</option>
      <option value="text/x-c++src">C++</option>
      <option value="text/x-csrc">C</option>
    </select>

    <select id="theme-selector">
      <option value="eclipse">Light Theme</option>
      <option value="material">Gray Theme</option>
      <option value="ayu-dark">Dark Theme</option>
    </select>
  </div>

  <div id="editor" class="editor"></div>
</body>
</html>